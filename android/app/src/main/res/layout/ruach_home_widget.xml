<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ruach_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_mark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/home_widget_label"
            android:src="@drawable/ruach_widget_mark" />

        <TextView
            android:id="@+id/w_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/jakarta"
            android:maxLines="1"
            android:text="@string/home_widget_label"
            android:textColor="@color/ruach_w_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ruach_widget_streak"
            android:fontFamily="@font/jakarta"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:text="🔥 0"
            android:textColor="@color/ruach_w_streak"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/w_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="7000"
        android:inAnimation="@anim/ruach_widget_in"
        android:outAnimation="@anim/ruach_widget_out">

        <LinearLayout
            android:id="@+id/w_face_focus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ruach_widget_chip"
                android:fontFamily="@font/jakarta"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingRight="8dp"
                android:paddingBottom="3dp"
                android:text="Défi du jour"
                android:textColor="@color/ruach_w_gold"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta"
                android:maxLines="2"
                android:text="Ouvre RuachEdu pour ta progression"
                android:textColor="@color/ruach_w_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/w_xp_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/w_xp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/ruach_widget_progress" />

                <TextView
                    android:id="@+id/w_xp_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/jakarta"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/ruach_w_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_face_quote"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/jakarta"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:text=""
                android:textColor="@color/ruach_w_ink"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/w_quote_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/jakarta"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/ruach_w_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
