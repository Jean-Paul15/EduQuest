<?xml version="1.0" encoding="utf-8"?>
<!-- Ink RuachEdu (cream900 #2A2218) assombri, reflet haut discret, liseré chaud. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#2A2218"
                android:endColor="#1C160F" />
            <stroke
                android:width="1dp"
                android:color="#3D2E13" />
        </shape>
    </item>
    <item android:height="54dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#1FFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
