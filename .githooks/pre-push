#!/bin/sh
set -e

echo "[pre-push] checks..."

if command -v flutter >/dev/null 2>&1; then
  flutter test
else
  echo "[pre-push] flutter not found, skip tests"
fi

if command -v pnpm >/dev/null 2>&1 && [ -f "site/package.json" ]; then
  pnpm --dir site build
else
  echo "[pre-push] pnpm/site not found, skip build"
fi

echo "[pre-push] ok"
